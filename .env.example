# Copy to .env and fill in. .env is git-ignored. Never commit real values.
GOOGLE_API_KEY=
MEM0_API_KEY=

# Postgres (local). The Toolbox user is least-privilege; set the password yourself.
DB_NAME=support
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=toolbox
DB_PASSWORD=

# Service ports (defaults from TECHNICAL.md)
TOOLBOX_PORT=5000
JUDGE_PORT=10002
MASKER_PORT=10003
PHOENIX_PORT=6006
WEB_PORT=8000
